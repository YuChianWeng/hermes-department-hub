# ── Python / test caches ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
# generated by tests/js/run.mjs (rewritten copy of desktop/department-hub/plugin.js)
tests/js/.tmp/

# ── Local runtime state (SQLite) ──────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db.init.lock

# ── Integration backup artifacts (kept on disk, not in history) ───────────
# 203 MB tar.gz of the pre-integration v1 tree + its 28 361-line hash list.
.research/pre-integration-backup-*.tar.gz
.research/pre-integration-backup-*.files.sha256

# ── Research lab sandboxes ────────────────────────────────────────────────
# Preserved on disk as historical evidence (see INTEGRATION-REPORT.md §5) but
# never committed: they are full HERMES_HOME copies (credentials in
# profiles/*/.env, state DBs, logs) and a ~800 MB uv package cache.
.research/lab/
.research/*/live-lab/
.research/route-lab-377/os-home/
.research/route-lab-377/board/
.research/route-lab-377/xdg/
.research/route-lab-377/runtime/
.research/route-lab-377/tmp/

# ── Evidence archives that must never be committed ────────────────────────
# Both files stay on disk as historical evidence (INTEGRATION-REPORT.md §5);
# they are untracked only. The zip contains synthetic runtime state DBs
# (route-lab-377/os-home/.hermes/state.db, .../profiles/manager/state.db,
# .../board/kanban.db) and the tar is a source snapshot. No real PII or
# credentials, but "no state DB / snapshot in git" is still the rule.
# INTEGRATION-MANIFEST.sha256 continues to cover their on-disk bytes.
.research/p0-route-followup-evidence.zip
.research/department-hub-m2-candidate.tar.gz
